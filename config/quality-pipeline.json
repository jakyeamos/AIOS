{
  "standard": {
    "version": "2026-04-26",
    "description": "Portable AIOS linked-project quality pipeline. Tier 1 is required for every active project; production-app and domain-specific gates apply only when a project declares the matching applicability tag.",
    "tiers": [
      {
        "key": "tier_1_core",
        "label": "Tier 1 Core",
        "description": "Portable gates required for every linked project."
      },
      {
        "key": "production_app",
        "label": "Production App",
        "description": "Additional release confidence gates for deployed products."
      },
      {
        "key": "domain_specific",
        "label": "Domain Specific",
        "description": "Only required when the project has the matching product domain."
      }
    ],
    "gates": [
      {
        "key": "install",
        "label": "Frozen Install",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "lint",
        "label": "Lint",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "typecheck",
        "label": "Typecheck",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "typescript_app"
        ]
      },
      {
        "key": "test",
        "label": "Test",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "build",
        "label": "Build",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "app",
          "typescript_app",
          "python_service"
        ]
      },
      {
        "key": "architecture",
        "label": "Architecture Boundary",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "ci",
        "label": "CI Quality Gate",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "secret_scan",
        "label": "Secret Scan",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app"
        ]
      },
      {
        "key": "env_validation",
        "label": "Environment Validation",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app"
        ]
      },
      {
        "key": "dependency_security",
        "label": "Dependency Security",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app"
        ]
      },
      {
        "key": "coverage",
        "label": "Coverage Gate",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app"
        ]
      },
      {
        "key": "e2e_smoke",
        "label": "E2E Smoke",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app"
        ]
      },
      {
        "key": "seo",
        "label": "SEO / Lighthouse",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "public_web"
        ]
      },
      {
        "key": "telemetry_utility",
        "label": "Telemetry Utility",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "telemetry_product"
        ]
      },
      {
        "key": "db_restore",
        "label": "Database Restore Drill",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "database_backed"
        ]
      },
      {
        "key": "pitr_monitor",
        "label": "PITR Monitor",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "database_backed"
        ]
      },
      {
        "key": "mobile_release",
        "label": "Mobile Release",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "mobile_app"
        ]
      },
      {
        "key": "full_e2e",
        "label": "Full Release E2E",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "public_web",
          "mobile_app"
        ]
      },
      {
        "key": "divergent_strategy_standard",
        "label": "Divergent Strategy Standard",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "aios_experiment_surface"
        ]
      }
    ]
  },
  "projects": [
    {
      "project_id": "aios",
      "applies_to": [
        "python_service",
        "typescript_app",
        "aios_experiment_surface"
      ],
      "full_pipeline": true,
      "gates": {
        "install": {
          "command": "uv sync --extra dev && pnpm install --frozen-lockfile",
          "working_directory": "."
        },
        "lint": {
          "command": "pnpm lint",
          "working_directory": "aios-ui"
        },
        "typecheck": {
          "command": "pnpm lint",
          "working_directory": "aios-ui"
        },
        "test": {
          "command": "uv run pytest -q",
          "working_directory": "."
        },
        "build": {
          "command": "pnpm build",
          "working_directory": "aios-ui"
        },
        "architecture": {
          "command": "uv run python bin/architecture-enforcement.py --project aios",
          "working_directory": "."
        },
        "ci": {
          "command": "local quality gate matrix",
          "working_directory": "."
        },
        "divergent_strategy_standard": {
          "command": "uv run pytest tests/test_divergent_strategy.py tests/test_workflow_experiments.py tests/test_corpus_eval.py -q",
          "working_directory": "."
        }
      }
    },
    {
      "project_id": "soundscape-app",
      "applies_to": [
        "typescript_app",
        "production_app",
        "public_web",
        "telemetry_product",
        "database_backed",
        "mobile_app"
      ],
      "full_pipeline": true,
      "gates": {
        "install": {
          "command": "pnpm install --frozen-lockfile",
          "working_directory": "."
        },
        "lint": {
          "command": "pnpm lint",
          "working_directory": "."
        },
        "typecheck": {
          "command": "pnpm typecheck",
          "working_directory": "."
        },
        "test": {
          "command": "pnpm test",
          "working_directory": "."
        },
        "build": {
          "command": "pnpm build",
          "working_directory": "."
        },
        "architecture": {
          "command": "node scripts/aios-architecture-check.mjs",
          "working_directory": "."
        },
        "ci": {
          "command": ".github/workflows/pr-checks.yml",
          "working_directory": "."
        },
        "secret_scan": {
          "command": "gitleaks/gitleaks-action in pr-checks.yml",
          "working_directory": "."
        },
        "env_validation": {
          "command": "pnpm env:check",
