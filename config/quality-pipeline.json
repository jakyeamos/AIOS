        "required": true,
        "applicability": [
          "aios_experiment_surface"
        ]
      },
      {
        "key": "repo_truth",
        "label": "Project Truth / Agent Instructions",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "pre_cr",
        "label": "Pre-CR / Changed-Line Readiness",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "package",
        "label": "Package / Consumer Smoke",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "developer_tool"
        ]
      },
      {
        "key": "validation",
        "label": "Class-Specific Validation",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "python_data_research_course",
          "content_vault_container"
        ]
      }
    ],
    "classes": {
      "platform_control_plane": {
        "label": "Platform/control-plane",
        "required_gates": [
          "install",
          "lint",
          "typecheck",
          "test",
          "build",
          "architecture",
          "pre_cr",
          "repo_truth",
          "secret_scan",
          "dependency_security",
          "ci",
          "pre_pr_readiness",
          "thermo_nuclear_simplification"
        ],
        "readiness_note": "AIOS itself must prove both platform runtime health and experiment/pre-PR governance health."
      },
      "production_public_web_app": {
        "label": "Production/public web app",
        "required_gates": [
          "install",
          "lint",
          "typecheck",
          "test",
          "build",
          "architecture",
          "pre_cr",
          "repo_truth",
          "secret_scan",
          "env_validation",
          "dependency_security",
          "ci",
          "e2e_smoke"
        ],
        "readiness_note": "Public apps require release confidence, environment checks, secret/dependency safety, smoke or e2e coverage, and CI/default-branch proof."
      },
      "developer_tool_package": {
        "label": "Developer tool/package",
        "required_gates": [
          "install",
          "lint",
          "typecheck",
          "test",
          "package",
          "architecture",
          "pre_cr",
          "repo_truth",
          "secret_scan",
          "dependency_security",
          "ci"
        ],
        "readiness_note": "Tools and packages require package/build or consumer smoke evidence in addition to tests and static checks."
      },
      "python_data_research_course": {
        "label": "Python/data/research/course",
        "required_gates": [
          "install",
          "lint",
          "test",
          "validation",
          "architecture",
          "pre_cr",
          "repo_truth",
          "secret_scan",
          "dependency_security",
          "ci"
        ],
        "readiness_note": "Research, course, and data repos use validation gates that fit notebooks, scripts, datasets, or assignment structure instead of fake app builds."
      },
      "content_vault_container": {
        "label": "Content/vault/container",
        "required_gates": [
          "validation",
          "architecture",
          "pre_cr",
          "repo_truth",
          "secret_scan",
          "ci"
        ],
        "readiness_note": "Content and container repos require aggregate or delegated validation; diff-only floor checks are not mature readiness."
      }
    },
    "non_remote_ci_exception_schema": {
      "required_fields": [
        "owner",
        "reason",
        "review_date",
        "local_proof_command",
        "replacement_path"
      ],
      "status": "allowed_only_when_remote_ci_is_not_appropriate",
      "readiness_rule": "A repo without remote CI is not adoption-ready unless this exception is recorded in AIOS truth and the replacement local proof passes."
    },
    "adoption_readiness_rule": {
      "repo_local_contract": "Repo-local .aios-quality-gate.json declares gate IDs only.",
      "aios_owned_commands": "Executable commands live in AIOS-owned config/quality-gates.json and config/quality-pipeline.json.",
      "weak_markers": [
        "floor_only",
        "pre_cr_only"
      ],
      "weak_marker_rule": "A repo with floor_only or pre_cr_only maturity cannot be marked adoption-ready."
    }
  },
