        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "database_backed"
        ]
      },
      {
        "key": "mobile_release",
        "label": "Mobile Release",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "mobile_app"
        ]
      },
      {
        "key": "full_e2e",
        "label": "Full Release E2E",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "public_web",
          "mobile_app"
        ]
      },
      {
        "key": "divergent_strategy_standard",
        "label": "Divergent Strategy Standard",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "aios_experiment_surface"
        ]
      },
      {
        "key": "thermo_nuclear_simplification",
