        },
        "e2e_smoke": {
          "command": "pnpm e2e:smoke",
          "working_directory": "."
        },
        "seo": {
          "command": "pnpm tsx packages/web/scripts/validate-seo.ts && pnpm lighthouse",
          "working_directory": "."
        },
        "telemetry_utility": {
          "command": "pnpm telemetry:utility:validate && pnpm telemetry:utility:test",
          "working_directory": "."
        },
        "db_restore": {
          "command": ".github/workflows/restore-drill.yml",
          "working_directory": "."
        },
        "pitr_monitor": {
          "command": ".github/workflows/pitr-monitoring.yml",
          "working_directory": "."
        },
        "mobile_release": {
          "command": ".github/workflows/mobile-release.yml",
          "working_directory": "."
        },
        "full_e2e": {
          "command": ".github/workflows/release-e2e-full.yml",
          "working_directory": "."
        }
      }
    },
