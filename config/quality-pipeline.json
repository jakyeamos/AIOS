{
  "standard": {
    "version": "2026-04-26",
    "description": "Portable AIOS linked-project quality pipeline. Tier 1 is required for every active project; production-app and domain-specific gates apply only when a project declares the matching applicability tag.",
    "tiers": [
      {
        "key": "tier_1_core",
        "label": "Tier 1 Core",
        "description": "Portable gates required for every linked project."
      },
      {
        "key": "production_app",
        "label": "Production App",
        "description": "Additional release confidence gates for deployed products."
      },
      {
        "key": "domain_specific",
        "label": "Domain Specific",
        "description": "Only required when the project has the matching product domain."
      }
    ],
    "gates": [
      {
        "key": "install",
        "label": "Frozen Install",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "lint",
        "label": "Lint",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "typecheck",
        "label": "Typecheck",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "typescript_app"
        ]
      },
      {
        "key": "test",
        "label": "Test",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "build",
        "label": "Build",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "app",
          "typescript_app",
          "python_service"
        ]
      },
      {
        "key": "architecture",
        "label": "Architecture Boundary",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "ci",
        "label": "CI Quality Gate",
        "tier": "tier_1_core",
        "required": true,
        "applicability": [
          "all"
        ]
      },
      {
        "key": "pre_pr_readiness",
        "label": "Pre-PR Readiness",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "aios_experiment_surface"
        ]
      },
      {
        "key": "secret_scan",
        "label": "Secret Scan",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app",
          "developer_tool",
          "python_data_research_course"
        ]
      },
      {
        "key": "env_validation",
        "label": "Environment Validation",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app"
        ]
      },
      {
        "key": "dependency_security",
        "label": "Dependency Security",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app",
          "developer_tool",
          "python_data_research_course"
        ]
      },
      {
        "key": "coverage",
        "label": "Coverage Gate",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app"
        ]
      },
      {
        "key": "e2e_smoke",
        "label": "E2E Smoke",
        "tier": "production_app",
        "required": true,
        "applicability": [
          "production_app"
        ]
      },
      {
        "key": "seo",
        "label": "SEO / Lighthouse",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "public_web"
        ]
      },
      {
        "key": "telemetry_utility",
        "label": "Telemetry Utility",
        "tier": "domain_specific",
        "required": true,
        "applicability": [
          "telemetry_product"
        ]
      },
      {
        "key": "db_restore",
        "label": "Database Restore Drill",
