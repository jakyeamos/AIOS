      "input_schema": {
        "humanized_text": "string"
      },
      "output_schema": {
        "passed": "boolean",
        "issues": "string[]"
      },
      "invariants": [
        "Validation output must be explicit pass/fail."
      ],
      "failure_conditions": [
        "Missing required section headings."
      ],
      "side_effects": [],
      "execution_mode": "deterministic"
    },
    {
      "key": "citation_checker",
      "purpose": "Verify citation coverage is present and non-empty.",
      "allowed_stages": [
        "validate"
      ],
      "input_schema": {
        "humanized_text": "string"
      },
      "output_schema": {
        "passed": "boolean",
        "issues": "string[]"
      },
      "invariants": [
        "No fake citation claims when no citation marker exists."
      ],
      "failure_conditions": [
        "No citation markers in output."
      ],
      "side_effects": [],
      "execution_mode": "deterministic"
    },
    {
