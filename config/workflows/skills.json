      ],
      "input_schema": {
        "draft_text": "string",
        "style_profile": "object"
      },
      "output_schema": {
        "humanized_text": "string"
      },
      "invariants": [
        "Must preserve factual meaning.",
        "Must preserve argument structure.",
        "Must preserve citation references."
      ],
      "failure_conditions": [
        "Meaning drift beyond configured threshold."
      ],
      "side_effects": [],
      "execution_mode": "heuristic"
    },
    {
      "key": "structure_checker",
      "purpose": "Verify required paper structure is present.",
