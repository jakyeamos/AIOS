      ],
      "input_schema": {
        "objective": "string",
        "output_text": "string"
      },
      "output_schema": {
        "passed": "boolean",
        "issues": "string[]"
      },
      "invariants": [
        "Detect obvious out-of-scope expansion."
      ],
      "failure_conditions": [
        "Output does not reference objective terms."
      ],
      "side_effects": [],
      "execution_mode": "deterministic"
