{
  "version": "2026-04-23",
  "skills": [
    {
      "key": "prompt_library_normalizer",
      "purpose": "Map loose request wording to a validated prompt template and normalized intent contract.",
      "allowed_stages": [
        "normalize_prompt"
      ],
      "input_schema": {
        "objective": "string",
        "workflow_key": "string"
      },
      "output_schema": {
        "template_id": "string|null",
        "normalized_prompt": "string"
      },
      "invariants": [
        "Preserve user intent.",
        "Do not introduce new task objectives."
      ],
      "failure_conditions": [
        "No template match and no fallback prompt."
      ],
      "side_effects": [],
      "execution_mode": "deterministic"
    },
    {
      "key": "obsidian_corpus_retriever",
      "purpose": "Retrieve bounded style profile context from the personal corpus for writing tasks.",
      "allowed_stages": [
        "enrich_context"
      ],
      "input_schema": {
        "objective": "string",
        "vault_root": "string"
      },
      "output_schema": {
        "style_profile": "object",
        "evidence_notes": "string[]"
      },
      "invariants": [
        "Retrieve bounded excerpts only.",
        "Do not dump full notes into prompts."
      ],
      "failure_conditions": [
        "Vault unavailable and no fallback style profile."
      ],
      "side_effects": [],
      "execution_mode": "deterministic"
    },
    {
      "key": "academic_draft_generator",
      "purpose": "Generate structured draft sections from normalized objective and context profile.",
      "allowed_stages": [
        "generate"
      ],
      "input_schema": {
        "normalized_prompt": "string",
        "style_profile": "object"
      },
      "output_schema": {
        "draft_text": "string"
      },
      "invariants": [
        "Preserve argument intent and section structure."
      ],
      "failure_conditions": [
        "Missing sectioned draft output."
      ],
      "side_effects": [],
      "execution_mode": "heuristic"
    },
    {
