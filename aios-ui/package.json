{
  "name": "aios-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/assert-runtime-pages-dynamic.mjs && node scripts/generate-prompt-catalog.mjs --check && node scripts/generate-workflow-catalog.mjs --check",
    "start": "next start",
    "prompts:generate": "node scripts/generate-prompt-catalog.mjs",
    "prompts:check": "node scripts/generate-prompt-catalog.mjs --check",
    "workflows:generate": "node scripts/generate-workflow-catalog.mjs",
    "workflows:check": "node scripts/generate-workflow-catalog.mjs --check",
    "runtime-pages:check": "node scripts/assert-runtime-pages-dynamic.mjs",
    "test:runtime-pages": "node --test scripts/assert-runtime-pages-dynamic.test.mjs",
    "lint": "eslint . && tsc --noEmit",
    "lint:warning-baseline": "node scripts/assert-eslint-warning-baseline.mjs",
    "lint:architecture": "dependency-cruiser --config .dependency-cruiser.cjs app components lib server --output-type err-long",
    "lint:anti-slop:fixtures": "eslint --config eslint/anti-slop-fixtures.config.mjs \"eslint/fixtures/anti-slop/pass/**/*.jsx\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.11",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^11.8.1",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "superjson": "^2.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-anti-slop": "file:vendor/eslint-plugin-anti-slop",
    "typescript": "^5.7.3"
  }
}
