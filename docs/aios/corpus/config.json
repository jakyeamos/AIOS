{
  "version": 1,
  "description": "AIOS corpus evaluation config. Every repo is copied or synthesized before commands run.",
  "defaultTimeoutMs": 30000,
  "environment": {
    "AIOS_CORPUS_EVAL": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "repos": [
    {
      "id": "aios-copy",
      "type": "aios-python-workspace",
      "strategy": "copy",
      "source": "{aiosRoot}",
      "modes": ["migrated", "scratch-real"],
      "tags": ["real", "aios-state", "python", "workspace"],
      "sample": true
    },
    {
      "id": "node-typescript-fixture",
      "type": "node-typescript",
      "strategy": "synthetic-fixture",
      "fixture": "node-typescript",
      "modes": ["synthetic"],
      "tags": ["synthetic", "node", "typescript"],
      "sample": true
    },
    {
      "id": "python-fixture",
      "type": "python",
      "strategy": "synthetic-fixture",
      "fixture": "python-basic",
      "modes": ["synthetic"],
      "tags": ["synthetic", "python"],
      "sample": true
    },
    {
      "id": "docs-only-fixture",
      "type": "docs-only",
      "strategy": "synthetic-fixture",
      "fixture": "docs-only",
      "modes": ["synthetic"],
      "tags": ["synthetic", "docs"],
      "sample": true
    },
    {
      "id": "dirty-worktree-fixture",
      "type": "dirty-worktree",
      "strategy": "synthetic-fixture",
      "fixture": "node-typescript",
      "dirty": true,
      "modes": ["synthetic"],
      "tags": ["synthetic", "dirty", "node"],
      "sample": false
    },
    {
      "id": "malformed-aios-state-fixture",
      "type": "malformed-aios-state",
      "strategy": "synthetic-fixture",
      "fixture": "malformed-aios-state",
      "modes": ["negative"],
      "tags": ["synthetic", "negative", "aios-state"],
      "sample": false
    }
  ],
  "commands": [
    {
      "name": "aios-help",
      "suite": "cli-routing",
      "argv": ["{python}", "{aiosRoot}/bin/aios.py", "--help"],
      "modes": ["migrated", "scratch-real", "synthetic", "negative"],
      "assertions": {
        "stdoutIncludes": ["AIOS unified JSON-first CLI"]
      },
      "sample": true
    },
    {
      "name": "aios-status-json",
      "suite": "cli-routing",
      "argv": [
        "{python}",
        "{aiosRoot}/bin/aios.py",
        "--json",
        "--db",
        "{stateDb}",
        "--logs-dir",
        "{stateLogs}",
        "--config-root",
        "{aiosRoot}/config",
        "status"
      ],
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "parsedJson": true,
        "parsedJsonPaths": [
          {"path": "ok", "equals": true},
          {"path": "command", "equals": "status"}
        ]
      },
      "sample": true
    },
    {
      "name": "aios-health-json",
      "suite": "state-persistence",
      "argv": [
        "{python}",
        "{aiosRoot}/bin/aios.py",
        "--json",
        "--db",
        "{stateDb}",
        "--logs-dir",
        "{stateLogs}",
        "--config-root",
        "{aiosRoot}/config",
        "health"
      ],
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "parsedJson": true,
        "parsedJsonPaths": [
          {"path": "ok", "equals": true},
          {"path": "command", "equals": "health"}
        ]
      },
      "sample": true
    },
    {
      "name": "aios-metadata-json",
      "suite": "repo-intelligence",
      "argv": [
        "{python}",
        "{aiosRoot}/bin/aios.py",
        "--json",
        "--db",
        "{stateDb}",
        "--logs-dir",
        "{stateLogs}",
        "--config-root",
        "{aiosRoot}/config",
        "metadata"
      ],
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "parsedJson": true,
        "parsedJsonPaths": [
          {"path": "ok", "equals": true},
          {"path": "command", "equals": "metadata"},
          {"path": "data.success_criteria.catalog.count", "min": 1},
          {"path": "data.workflow_orchestration.registry.count", "min": 1}
        ]
      },
      "sample": true
    },
    {
      "name": "prompt-library-validate",
      "suite": "prompt-library",
      "argv": ["{python}", "{aiosRoot}/bin/validate-prompts.py", "--prompts-root", "{workspace}/prompts"],
      "modes": ["migrated", "scratch-real", "synthetic", "negative"],
      "repoTypes": ["aios-python-workspace"],
      "expectedMutations": ["prompts/registry.json"],
      "assertions": {
        "stdoutIncludes": ["validated", "wrote"]
      },
      "sample": true
    },
    {
      "name": "skills-status-json",
      "suite": "workflows",
      "argv": [
        "{python}",
        "{aiosRoot}/bin/aios.py",
        "--json",
        "--db",
        "{stateDb}",
        "--logs-dir",
        "{stateLogs}",
        "--config-root",
        "{aiosRoot}/config",
        "skills",
        "status"
      ],
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "parsedJson": true,
        "parsedJsonPaths": [
          {"path": "ok", "equals": true},
          {"path": "command", "equals": "skills-status"}
        ]
      },
      "sample": true
    },
    {
      "name": "criteria-contracts-audit",
      "suite": "success-criteria",
      "argv": [
        "{python}",
        "{aiosRoot}/bin/aios.py",
        "--json",
        "--db",
        "{stateDb}",
        "--logs-dir",
        "{stateLogs}",
        "--config-root",
        "{aiosRoot}/config",
        "contracts-audit"
      ],
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "parsedJson": true,
        "parsedJsonPaths": [
          {"path": "ok", "equals": true},
          {"path": "command", "equals": "contracts-audit"}
        ]
      },
      "sample": true
    },
    {
      "name": "workflow-start-work",
      "suite": "workflows",
      "argv": [
        "{python}",
        "{aiosRoot}/bin/aios.py",
        "--json",
        "--db",
        "{stateDb}",
        "--logs-dir",
        "{stateLogs}",
        "--config-root",
        "{aiosRoot}/config",
        "start-work",
        "Corpus workflow execution quality probe",
        "--project",
        "fixture",
        "--session-id",
        "session-fixture"
      ],
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "parsedJson": true,
        "parsedJsonPaths": [
          {"path": "ok", "equals": true},
          {"path": "command", "equals": "start-work"},
          {"path": "data.run.id", "exists": true}
        ],
        "dbRows": [
          {"sql": "SELECT COUNT(*) FROM orchestration_runs WHERE objective='Corpus workflow execution quality probe'", "min": 1}
        ]
      },
      "sample": false
    },
    {
      "name": "hook-session-start-event",
      "suite": "hooks",
      "argv": ["{python}", "{aiosRoot}/bin/hook-session-start.py"],
      "stdin": "{\"session_id\":\"corpus-session-{repoId}-{mode}\",\"cwd\":\"{workspace}\",\"objective\":\"Corpus hook side effect probe\"}",
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "artifactsExist": ["{stateLogs}/current_session"],
        "dbRows": [
          {"sql": "SELECT COUNT(*) FROM sessions WHERE id='corpus-session-{repoId}-{mode}'", "min": 1},
          {"sql": "SELECT COUNT(*) FROM tool_events WHERE session_id='corpus-session-{repoId}-{mode}' AND event_type='SessionStart'", "min": 1}
        ]
      },
      "sample": false
    },
    {
      "name": "hook-prompt-submit-event",
      "suite": "hooks",
      "argv": ["{python}", "{aiosRoot}/bin/hook-prompt-submit.py"],
      "stdin": "{\"session_id\":\"corpus-session-{repoId}-{mode}\",\"prompt\":\"Debug the synthetic corpus fixture and explain the safest next action\"}",
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "dbRows": [
          {"sql": "SELECT COUNT(*) FROM prompts_used WHERE session_id='corpus-session-{repoId}-{mode}'", "min": 1},
          {"sql": "SELECT COUNT(*) FROM tool_events WHERE session_id='corpus-session-{repoId}-{mode}' AND event_type='UserPromptSubmit'", "min": 1}
        ]
      },
      "sample": false
    },
    {
      "name": "cts-build",
      "suite": "repo-intelligence",
      "argv": ["{python}", "{aiosRoot}/bin/cts-build.py", "--repo", "{workspace}"],
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "parsedJson": true,
        "parsedJsonPaths": [
          {"path": "repo_id", "exists": true},
          {"path": "repo_path", "exists": true},
          {"path": "total_files", "min": 0}
        ]
      },
      "sample": false
    },
    {
      "name": "cts-status",
      "suite": "repo-intelligence",
      "argv": ["{python}", "{aiosRoot}/bin/cts-status.py", "--repo", "{workspace}"],
      "modes": ["migrated", "scratch-real", "synthetic"],
      "expectedMutations": [".aios-corpus-state/"],
      "assertions": {
        "parsedJson": true,
        "parsedJsonPaths": [
          {"path": "repo_id", "exists": true},
          {"path": "index_status", "exists": true}
        ]
      },
      "sample": false
    },
    {
      "name": "dirty-worktree-detected",
      "suite": "dirty-worktree",
      "argv": ["git", "status", "--short"],
      "modes": ["synthetic"],
      "repoTypes": ["dirty-worktree"],
      "assertions": {
        "stdoutIncludes": ["dirty-note.txt"],
        "gitStatusIncludes": ["dirty-note.txt"]
      },
      "sample": false
    },
    {
      "name": "unknown-command-clean-failure",
      "suite": "negative",
      "argv": [
        "{python}",
        "{aiosRoot}/bin/aios.py",
        "--json",
        "--db",
        "{stateDb}",
        "--logs-dir",
        "{stateLogs}",
        "definitely-not-a-command"
      ],
      "modes": ["negative", "synthetic"],
      "expectedFailure": true,
      "assertions": {
        "stderrIncludes": ["invalid choice"],
        "stderrExcludes": ["Traceback (most recent call last)", "UnhandledPromiseRejection"]
      },
      "sample": false
    },
    {
      "name": "missing-db-clean-failure-json",
      "suite": "negative",
      "argv": [
        "{python}",
        "{aiosRoot}/bin/aios.py",
        "--json",
        "--db",
        "{stateRoot}/missing/aios.db",
        "--logs-dir",
        "{stateLogs}",
        "status"
      ],
      "modes": ["negative", "synthetic"],
      "expectedFailure": true,
      "assertions": {
        "parsedJson": true,
        "parsedJsonPaths": [
          {"path": "ok", "equals": false},
          {"path": "error.code", "equals": "db-not-found"}
        ]
      },
      "sample": false
    }
  ]
}
