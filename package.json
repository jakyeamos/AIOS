{
  "name": "aios",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "context-compiler-contract": "file:../context-compiler-contract"
  },
  "scripts": {
    "context:compile": "node tools/context-compile.mjs",
    "context:validate": "node tools/context-compile.mjs --validate",
    "tmcp:no-op-scan": "node tools/no-op-instruction-scan.mjs",
    "test:context": "node --test tests/context-compiler.test.mjs",
    "test:no-op-scan": "node --test tests/no-op-instruction-scan.test.mjs",
    "test:wiki": "node --test tests/wiki-maintenance.test.mjs",
    "wiki:check": "node tools/wiki-check.mjs",
    "format:check": "uv run --locked ruff format --check .",
    "dead-code": "uv run vulture bin services --min-confidence 70",
    "audit:dead-code": "pnpm dead-code",
    "smoke": "uv run python bin/aios.py --help",
    "security:audit": "uv run --locked pip-audit",
    "security:secrets": "gitleaks detect --source . --no-banner --redact",
    "quality:eval": "bash scripts/quality-eval.sh",
    "corpus:evaluate": "node scripts/aios-corpus-eval.cjs",
    "deploy:preview:watch": "bash scripts/vercel-deploy-watch.sh preview",
    "deploy:prod:watch": "bash scripts/vercel-deploy-watch.sh prod"
  }
}
