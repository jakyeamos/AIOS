{
  "name": "aios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "context:compile": "node tools/context-compile.mjs",
    "context:validate": "node tools/context-compile.mjs --validate",
    "test:context": "node --test tests/context-compiler.test.mjs",
    "test:wiki": "node --test tests/wiki-maintenance.test.mjs",
    "wiki:check": "node tools/wiki-check.mjs",
    "quality:eval": "bash scripts/quality-eval.sh",
    "corpus:evaluate": "node scripts/aios-corpus-eval.cjs",
    "deploy:preview:watch": "bash scripts/vercel-deploy-watch.sh preview",
    "deploy:prod:watch": "bash scripts/vercel-deploy-watch.sh prod"
  }
}
